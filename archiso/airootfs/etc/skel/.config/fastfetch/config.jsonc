{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/hycac/hycac-ascii.txt",
    "padding": { "top": 0, "left": 4, "right": 4 }
  },
  "display": {
    "color": { "keys": "magenta", "title": "cyan" },
    "separator": ": ",
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    "break",
    { "type": "os",       "key": "OS" },
    { "type": "kernel",   "key": "Kernel" },
    { "type": "uptime",   "key": "Uptime" },
    { "type": "de",       "key": "Compositor" },
    { "type": "shell",    "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu",      "key": "CPU" },
    { "type": "gpu",      "key": "GPU" },
    { "type": "memory",   "key": "Memory" },
    { "type": "break" },
    { "type": "colors", "paddingLeft": 4, "symbol": "circle" }
  ]
}
